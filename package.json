{
  "name": "samvidha-management-services",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "include": [
      "/",
      "/about",
      "/services",
      "/projects",
      "/careers",
      "/contact"
    ],
    "inlineCss": false,
    "skipThirdPartyRequests": true,
    "waitFor": 3500,
    "timeout": 60000,
    "puppeteerExecutablePath": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.15.1",
    "react-snap": "^1.23.0",
    "swiper": "^12.1.4"
  }
}
